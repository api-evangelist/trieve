{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trieve REST Chunk Dataset API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Dataset",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a dataset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.trieve.ai/api/dataset"
          },
          "docs": "Create a new dataset within an organization. Caller must be an\norganization owner.\n"
        }
      ]
    }
  ],
  "bundled": true
}